# ---------------------------------------------------------------- application
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
# seed the demo tenant + sample docs on startup (dev/demo only)
AUTO_SEED=true
# true only for the sqlite quickstart; otherwise `alembic upgrade head`
DB_AUTO_CREATE=false
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- datastores
DATABASE_URL=postgresql+asyncpg://bfsi:bfsi@localhost:5432/bfsi
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- security (CHANGE ALL OF THESE outside local dev)
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
# Fernet key for integration credentials:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Shared secret used to verify customer assertions issued by the institution's IdP (prototype: HS256)
CUSTOMER_ASSERTION_SECRET=demo-bank-idp-shared-secret-32bytes!
MAX_AUTH_FAILURES=3
SESSION_IDLE_TIMEOUT_SECONDS=1800
PENDING_ACTION_TTL_SECONDS=300

# ---------------------------------------------------------------- LLM (any OpenAI-compatible endpoint)
# rule_based = offline deterministic stand-in (no key needed); openai = hosted; local = vLLM/TGI/Ollama
LLM_PROVIDER=rule_based
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_PROVIDER=rule_based
LLM_TIMEOUT_SECONDS=30
LLM_PARALLEL_TOOL_CALLS=true

# ---------------------------------------------------------------- orchestration (see docs/orchestration.md)
MAX_AGENT_ITERATIONS=4
MAX_WORKFLOW_STEPS=12
WORKFLOW_TIMEOUT=45
DEFAULT_TOOL_TIMEOUT=10
MAX_PARALLEL_TOOLS=4
MAX_SESSION_CONCURRENT_TOOLS=4
# per worker process; NOT cluster-wide (N workers => N x this)
TOOL_GLOBAL_CONCURRENCY=64
TOOL_GROUP_LIMITS={"banking_api": 16, "knowledge": 16}
# also enforce TOOL_GROUP_LIMITS across all workers with Redis leases
DISTRIBUTED_TOOL_LIMITS=false
MAX_MUTATIONS_PER_PLAN=1
READ_RETRY_COUNT=2
# idempotent, keyed, non-financial writes only; financial writes are never retried
WRITE_RETRY_COUNT=1
VERIFICATION_ATTEMPTS=3
VERIFICATION_INTERVAL=0.5
SLOW_OPERATION_ACK_SECONDS=1.2
SESSION_LOCK_TTL=30
SESSION_LOCK_WAIT=20
REDIS_REQUIRED_IN_PRODUCTION=true

# ---------------------------------------------------------------- RAG
# or memory
KNOWLEDGE_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=bfsi-knowledge
# hashing (offline) | openai (any OpenAI-compatible /embeddings)
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# must match the index; changing it requires a new index
EMBEDDING_DIMENSIONS=384
# lexical | http | none
RERANKER_PROVIDER=lexical
# e.g. http://tei-reranker/rerank (TEI / Cohere-compatible)
RERANKER_URL=
RAG_TOP_K=5

# ---------------------------------------------------------------- voice / LiveKit
# LiveKit Cloud (needed for phone numbers): wss://<project>.livekit.cloud with that project's API key/secret.
# Leave unset with docker compose to use the bundled local dev server (devkey/secret, no PSTN).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# address handed to browsers/apps (defaults to LIVEKIT_URL)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=bfsi-voice-agent
# deepgram | sarvam | openai
STT_PROVIDER=deepgram
# sarvam | elevenlabs | openai
TTS_PROVIDER=sarvam
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
VOICE_MIN_ENDPOINTING_DELAY=0.5
VOICE_MAX_ENDPOINTING_DELAY=3.0
VOICE_MIN_INTERRUPTION_DURATION=0.5
VOICE_RECONNECT_GRACE_SECONDS=60
VOICE_MAX_CALL_SECONDS=1800
# ---------------------------------------------------------------- telephony: LiveKit Phone Numbers / LiveKit SIP
# Inbound numbers are bound to the agent with `python -m scripts.provision_telephony --tenant <slug> --number <E.164>`
LIVEKIT_SIP_ROOM_PREFIX=call-
LIVEKIT_SIP_DISPATCH_RULE_NAME=bfsi-inbound
# outbound calls only (callbacks); formerly SIP_TRUNK_ID (still accepted)
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
SIP_HUMAN_TRANSFER_URI=sip:contact-centre@pbx.example.com
# when all lines are busy: transfer here instead of "please call later" + hang up
SIP_OVERFLOW_TRANSFER_URI=
# HMAC key for the internal caller reference (defaults to a key derived from JWT_SECRET)
CALLER_ID_HASH_KEY=
# demo tenant's inbound numbers, used by the seed only (JSON list), e.g. ["+14155550123"]
DEMO_SIP_NUMBERS=[]

# ---------------------------------------------------------------- capacity (see docs/voice.md "Scaling")
# cluster-wide when REDIS_URL is set
MAX_ACTIVE_CALLS=200
# reported to LiveKit as worker load; a full worker receives no new calls
MAX_AGENT_SESSIONS_PER_WORKER=25
MAX_CONCURRENT_LLM_REQUESTS=64
LLM_QUEUE_TIMEOUT=5
MAX_CONCURRENT_STT_REQUESTS=200
MAX_CONCURRENT_TTS_REQUESTS=200
# alias of TOOL_GLOBAL_CONCURRENCY (per worker process)
# MAX_CONCURRENT_TOOLS=64

# ---------------------------------------------------------------- observability
OTEL_ENABLED=true
# e.g. http://localhost:4318 (Jaeger / OTel collector)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bfsi-agent-backend

# ---------------------------------------------------------------- mock bank (prototype)
MOCK_BANK_URL=http://localhost:8100
MOCK_BANK_API_KEY=mock-bank-api-key
